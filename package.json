{
  "name": "keyfall",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 47321 --strictPort",
    "dev:api": "wrangler dev --port 8787",
    "build": "tsc && tsc -p worker && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 47321 --strictPort",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "deploy": "npm run build && wrangler deploy",
    "db:init": "wrangler d1 execute keyfall --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute keyfall --local --file=schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261029.1",
    "@types/node": "^26.6.6",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "wrangler": "^4.155.0"
  }
}
